{
  "name": "cyber-lab-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "cyberlab": "node scripts/cyberlab.mjs",
    "setup": "node scripts/cyberlab.mjs setup",
    "setup:web": "node scripts/cyberlab.mjs web",
    "doctor": "node scripts/cyberlab.mjs doctor",
    "update": "node scripts/cyberlab.mjs update",
    "tunnel": "node scripts/cyberlab.mjs tunnel",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "release:check": "node scripts/release-check.mjs",
    "backup": "node scripts/backup-sqlite.mjs",
    "restore": "node scripts/restore-sqlite.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.90.5",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "deepmerge-ts": "8.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
