DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Set this only for the first administrator bootstrap. After an admin is created,
# remove this value and restart the application.
INITIAL_ADMIN_EMAIL=""

# Firebase Web SDK config (public project identifiers; configure providers/domains in Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK service account values (server only)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# For Cloudflare Tunnel/public HTTPS deployments, set APP_URL to the public
# https:// hostname and add that hostname to Firebase Authentication Authorized domains.
