DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# First-run administrator provisioning. Set a random one-time token of at least
# 32 characters. Optionally restrict the first administrator to one email address.
# Remove INITIAL_ADMIN_SETUP_TOKEN after the first administrator is created and restart.
INITIAL_ADMIN_SETUP_TOKEN=""
INITIAL_ADMIN_EMAIL=""

# Firebase Web SDK config (public project identifiers; configure providers/domains in Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK service account values (server only)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# For Cloudflare Tunnel/public HTTPS deployments, set APP_URL to the public
# https:// hostname and add that hostname to Firebase Authentication Authorized domains.
